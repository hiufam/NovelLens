<!DOCTYPE html>
<html>
  <body>
    <div id="main">
      <div id="main-container">
      </div>
    </div>

    <div id="shared-views" hidden>
      <%= render "shared/drag-box" %>
      <%= render "shared/doc-viewer" %>
      <%= render "shared/definition-viewer" %>
      <%= render "shared/images-viewer" %>
      <%= render "shared/wiki-viewer" %>
      <%= render "shared/note-viewer" %>
      <%= render "shared/viewer-overlay" %>
    </div>

    <div class="modal fade" id="note-title-modal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <%= form_with id: "note-title-form" do |form| %>
            <div class="modal-header">
              <h5 class="modal-title" id="exampleModalLabel">Enter note title</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="input-group">
                <%= form.text_field :title, class:"form-control note-title-text-input", required: true, placeholder: "Title" %>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-custom-secondary" data-bs-dismiss="modal">Close</button>
              <%= form.submit "Save", class: "btn btn-custom submit-button" %> 
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="offcanvas offcanvas-end" tabindex="-1" id="user-profile" aria-labelledby="offcanvasTopLabel">
      <div class="offcanvas-header">
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
      </div>
      <div class="offcanvas-body">
        <div class="profile">
          <div class="profile-head">
            <div class="tag">
              <span>
                Profile
              </span>
            </div>
            <div class="avatar">
              <i class="bi bi-person-fill" style="font-size: 38px; color: white;"></i>
            </div>
            <% unless @user.nil? %>
            <p class="fw-semibold profile-email">
              <%= @user.email_address %>
            </p>
            <button class="btn btn-primary sign-out-button">
              Sign out
            </button>
            <% else %>
            <button class="btn btn-primary sign-in-button">
              Sign in
            </button>
            <% end %>
          </div>

          <div class="profile-notes">
            <div class="tag">
              <span>
                Notes
              </span>
            </div>
            <div class="notes-list ">

            </div>
            <nav id="notes-pagination" aria-label="Page notes">
              <ul class="pagination">
                <!-- <li class="page-item"><a class="page-link" href="#">Previous</a></li>
                <li class="page-item"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">3</a></li>
                <li class="page-item"><a class="page-link" href="#">Next</a></li> -->
              </ul>
            </nav>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
