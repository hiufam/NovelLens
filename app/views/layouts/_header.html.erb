<header>
  <div class="header-container">
    <% flash.each do |type, message| %>
      <div class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-autohide="false" style="position: absolute; top: 12px; right: 12px;">
        <div class="toast-header">
          <strong class="mr-auto toast-title toast-<%= type %>">
            <%= type %>
          </strong>
          <button type="button" class="ml-auto mb-1 close" data-bs-dismiss="toast" data-dismiss="toast" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="toast-body">
          <%= message %>
        </div>
      </div>
    <% end %>

    <p class="h4 web-title">NovelLens</p>

    <% if current_page?(root_path) %>
      <div class="header-tool">
        <div id="viewers-dropdown">
          <button 
            class="btn btn-custom dropdown-toggle" 
            type="button" id="viewers-menu" 
            data-bs-toggle="dropdown" 
            aria-expanded="false"
          >
            <i class="bi bi-eye-fill"></i>
            Views
          </button>
          <ul class="dropdown-menu" aria-labelledby="viewers-menu">
          </ul>
        </div>

        <button id="reset-view" type="button" class="btn btn-custom">
          <i class="bi bi-arrow-clockwise"></i>
          Reset Views
        </button>

        <button 
          hidden
          id="toggle-headers"
          class="btn btn-custom header-tool-button"
          data-bs-toggle="tooltip" 
          data-bs-placement="bottom"
          data-bs-title="Toggle View Headers"
          type="button"
        >
          <i class="bi bi-grip-horizontal" style="font-size: 1.5rem;"></i>
        </button>
        <div class="avatar">
          <i class="bi bi-person-fill" style="font-size: 24px; color: white;"></i>
        </div>
      </div>
    <% end  %>
  </div>
</header>
