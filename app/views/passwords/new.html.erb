<div class="forgot-password-container">
  <h1>Forgot your password?</h1>

  <%= form_with url: passwords_path, class: "forgot-password-form" do |form| %>
    <%= form.email_field :email_address, class:"form-control", required: true, autofocus: true, autocomplete: "username", placeholder: "Enter your email address", value: params[:email_address] %><br>
    <%= form.submit "Email reset instructions", class: "btn btn-primary submit-button" %>
  <% end %>
</div>
