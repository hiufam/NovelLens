<div id="note-viewer" class="viewer note-viewer ">
  <div class="note-tools">
    <button class="btn btn-custom btn-sm note-save-button" type="button" data-bs-toggle="modal" data-bs-target="#note-title-modal">Create</button>
    <button class="btn btn-custom btn-sm note-load-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#user-profile">Load</button>
  </div>
  <div class="note-viewer-body">
    <textarea class="form-control note-textarea"></textarea>
  </div>
  <div class="viewer-spinner" hidden>
    <div class="spinner-border text-secondary" role="status">
      <span class="visually-hidden">Loading...</span>
    </div>
  </div>
</div>
